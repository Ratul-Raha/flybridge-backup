# ─── Payments (Stripe) ────────────────────────────────────────────────
# Replace placeholders with real keys from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_…/pk_test_…) during development.
# STRIPE_SECRET_KEY is the LIVE key: it must start with sk_live_ and is only
# used when the admin gateway mode is set to "live" (see Payment Settings).
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
# Optional: a separate test key lets you keep the live key untouched while the
# admin gateway toggle is set to "test". Falls back to STRIPE_SECRET_KEY when unset.
STRIPE_TEST_SECRET_KEY=
# STRIPE_MODE=test | live — default gateway mode on first load (defaults to test).
STRIPE_MODE=test
# Publishable key is only needed if you later add Stripe.js elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_me
# From https://dashboard.stripe.com/webhooks — endpoint: POST /api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.expired, payment_intent.payment_failed
# STRIPE_WEBHOOK_SECRET is the LIVE webhook secret (whsec_…).
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me
# Optional: separate test webhook secret used while gateway mode is "test".
STRIPE_WEBHOOK_SECRET_TEST=

# ─── Payments (EPS — Easy Payment System, Bangladesh) ──────────────────
# Sandbox credentials from https://www.eps.com.bd — replace with your live
# merchant credentials before going to production.
# EPS mode is controlled from the admin Payment Settings page.
#
# Production (live) merchant credentials — used when EPS mode is "production".
# Generic EPS_* names also work and are treated as the live credentials.
EPS_PRODUCTION_USERNAME=placeholder@example.com
EPS_PRODUCTION_PASSWORD=replace_me
EPS_PRODUCTION_HASH_KEY=replace_me
EPS_PRODUCTION_MERCHANT_ID=replace_me
EPS_PRODUCTION_STORE_ID=replace_me
#
# Optional sandbox overrides — only needed to test with your own sandbox
# account. When unset, the public EPS sandbox demo account is used.
EPS_SANDBOX_USERNAME=
EPS_SANDBOX_PASSWORD=
EPS_SANDBOX_HASH_KEY=
EPS_SANDBOX_MERCHANT_ID=
EPS_SANDBOX_STORE_ID=
# EPS_ENV=sandbox | production (defaults to sandbox) — default mode on first load.
EPS_ENV=sandbox
#
# IPN encryption key from the EPS merchant panel. Decrypts the AES-256-CBC
# payload EPS POSTs to /api/webhooks/eps. Distinct from EPS_*_HASH_KEY.
# Scope these like the merchant credentials above — the panel issues a different
# key per environment, and the one for the active mode is tried first.
EPS_PRODUCTION_IPN_SECRET=replace_me
EPS_SANDBOX_IPN_SECRET=
# Single-environment fallback when you only run one of the two.
EPS_IPN_SECRET=replace_me

# ─── Database ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://placeholder
MONGODB_DB=flybridge

# ─── Auth ─────────────────────────────────────────────────────────────
AUTH_SECRET=replace_with_a_long_random_secret

# ─── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=re_placeholder_replace_me
EMAIL_FROM="FlyBridge <hello@example.com>"

# ─── S3 (new media storage; Cloudinary kept only for legacy files) ─────
# Region + bucket name (e.g. AWS_REGION=eu-north-1)
AWS_REGION=eu-north-1
S3_BUCKET=placeholder
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

# ─── Media (Cloudinary, legacy only) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# ─── Azure Speech (STT + TTS for IELTS speaking quizzes) ───────────────
# From an Azure "Speech" resource (portal.azure.com → Create resource →
# Speech). Server-only — never prefix with NEXT_PUBLIC_.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: recognition locale (defaults to en-US).
AZURE_SPEECH_RECOG_LANG=en-US
# Optional: neural TTS voice for reading prompts aloud (defaults to en-US-JennyNeural).
AZURE_SPEECH_VOICE=en-US-JennyNeural

# ─── AI ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_placeholder
AI_MODEL=
# Cheaper model for small jobs (course quizzes + quiz grading). Falls back to AI_MODEL.
AI_QUIZ_MODEL=

# ─── Automation + payments cron guard (required for /api/cron/automations
# and /api/cron/payments) ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace_with_a_long_random_secret

# ─── Web Push (Chrome notifications) ─────────────────────────────────
# Generate with: cd apps/web && pnpm gen-vapid
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT="mailto:hello@example.com"

# ─── Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Admin traffic dashboard (/dashboard/admin/analytics) reads GA4 back through
# the Data API. The tag above only sends data — these are what make the numbers
# visible in the dashboard.
#
# Either credential route below works. A is the conventional service-account
# setup; B needs no key at all and is easier when key creation is unavailable.
#
# 1. GA4 → Admin → Property settings → copy the numeric "Property ID"
#    (not the G-XXXXXXXXXX measurement id). Needed for both routes.
GA4_PROPERTY_ID=
#
# A. Service account (key)
# 2. Google Cloud → enable the Analytics Data API → create a service account.
# 3. GA4 → Admin → Property access management → add that service account
#    with the "Viewer" role.
# 4. Paste the key from the downloaded JSON here. Keep the \n escapes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Alternatives to the two vars above (use one, not both):
#   GA4_SERVICE_ACCOUNT_JSON        full service-account JSON as one line
#   GOOGLE_APPLICATION_CREDENTIALS  path to the JSON key file (local dev only)
GA4_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
#
# B. OAuth login for your own Google account (no key)
# Use when creating a service-account key isn't possible. Your account needs
# "Viewer" on the GA4 property in step 3, granted to you rather than to a
# service account. Run `pnpm ga4-oauth <client_id> <client_secret>` to mint the
# refresh token — it prints the three lines below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Or paste the whole authorized_user JSON as one line:
GA4_OAUTH_JSON=

# ─── Meta (Ads) ───────────────────────────────────────────────────────
# Browser pixel. Safe to expose.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API token for the server-side Purchase event.
# SERVER ONLY — never prefix with NEXT_PUBLIC_.
META_CAPI_TOKEN=
# Optional, defaults to v21.0
META_GRAPH_VERSION=
