# ─── Payments (Stripe) ────────────────────────────────────────────────
# Replace placeholders with real keys from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_…/pk_test_…) during development.
# STRIPE_SECRET_KEY is the LIVE key: it must start with sk_live_ and is only
# used when the admin gateway mode is set to "live" (see Payment Settings).
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
# Optional: a separate test key lets you keep the live key untouched while the
# admin gateway toggle is set to "test". Falls back to STRIPE_SECRET_KEY when unset.
STRIPE_TEST_SECRET_KEY=
# STRIPE_MODE=test | live — default gateway mode on first load (defaults to test).
STRIPE_MODE=test
# Publishable key is only needed if you later add Stripe.js elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_me
# From https://dashboard.stripe.com/webhooks — endpoint: POST /api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.expired, payment_intent.payment_failed
# STRIPE_WEBHOOK_SECRET is the LIVE webhook secret (whsec_…).
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me
# Optional: separate test webhook secret used while gateway mode is "test".
STRIPE_WEBHOOK_SECRET_TEST=

# ─── Payments (EPS — Easy Payment System, Bangladesh) ──────────────────
# Sandbox credentials from https://www.eps.com.bd — replace with your live
# merchant credentials before going to production.
# EPS mode is controlled from the admin Payment Settings page.
EPS_USERNAME=placeholder@example.com
EPS_PASSWORD=replace_me
EPS_HASH_KEY=replace_me
EPS_MERCHANT_ID=replace_me
EPS_STORE_ID=replace_me
# EPS_ENV=sandbox | production (defaults to sandbox) — default mode on first load.
EPS_ENV=sandbox

# ─── Database ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://placeholder
MONGODB_DB=flybridge

# ─── Auth ─────────────────────────────────────────────────────────────
AUTH_SECRET=replace_with_a_long_random_secret

# ─── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=re_placeholder_replace_me
EMAIL_FROM="FlyBridge <hello@example.com>"

# ─── S3 (new media storage; Cloudinary kept only for legacy files) ─────
# Region + bucket name (e.g. AWS_REGION=eu-north-1)
AWS_REGION=eu-north-1
S3_BUCKET=placeholder
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

# ─── Media (Cloudinary, legacy only) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# ─── AI ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_placeholder
AI_MODEL=

# ─── Automation + payments cron guard (required for /api/cron/automations
# and /api/cron/payments) ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace_with_a_long_random_secret

# ─── Web Push (Chrome notifications) ─────────────────────────────────
# Generate with: cd apps/web && pnpm gen-vapid
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT="mailto:hello@example.com"

# ─── Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
